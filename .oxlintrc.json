{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "oxc", "jest", "promise"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
    "demo/dist/**",
    "src/plugins/CodeBlockPlugin/utils/languages/definitions/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "warn",
    "style": "warn",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-console": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "curly": ["error", "all"],
    "prefer-template": "warn",
    "no-nested-ternary": "warn",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_exhaustive", "_onOut"],
        "allowAfterThis": true,
        "enforceInMethodNames": false
      }
    ],

    "sort-keys": "off",
    "sort-imports": "off",
    "sort-vars": "off",
    "id-length": "off",
    "func-style": "off",
    "one-var": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "new-cap": "off",
    "max-statements": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-params": "off",
    "prefer-destructuring": "off",
    "no-continue": "off",
    "require-unicode-regexp": "off",
    "capitalized-comments": "off",
    "no-inline-comments": "off",
    "init-declarations": "off",

    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowAny": false,
        "allowNullableBoolean": true,
        "allowNullableNumber": false,
        "allowNullableObject": true,
        "allowNullableString": true,
        "allowNumber": true,
        "allowString": true
      }
    ],
    "typescript/no-confusing-void-expression": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-void-return": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/method-signature-style": "off",
    "typescript/parameter-properties": "off",

    "import/no-cycle": "error",
    "import/first": "error",
    "import/newline-after-import": "off",
    "import/no-duplicates": "off",
    "no-duplicate-imports": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "import/no-default-export": "off",
    "import/no-unassigned-import": "off",
    "import/no-anonymous-default-export": "off",
    "import/max-dependencies": "off",
    "import/no-nodejs-modules": "off",

    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/explicit-length-check": "warn",
    "unicorn/prefer-spread": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-dom-node-dataset": "warn",
    "unicorn/no-lonely-if": "warn",
    "unicorn/no-nested-ternary": "warn",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/max-nested-calls": "off",

    "oxc/no-map-spread": "off",

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/no-multiple-resolved": "error",
    "promise/always-return": "warn",
    "promise/prefer-await-to-callbacks": "off",

    "unicorn/consistent-function-scoping": "warn",

    "typescript/consistent-return": "warn",
    "typescript/no-misused-spread": "warn",
    "typescript/no-base-to-string": "warn",

    "jest/prefer-ending-with-an-expect": "off",
    "jest/require-hook": "off",
    "jest/no-hooks": "off",
    "jest/require-top-level-describe": "off",
    "jest/no-conditional-in-test": "warn",
    "jest/no-conditional-expect": "warn",
    "jest/valid-expect": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,js,mjs}", "**/__tests__/**/*.{ts,js,mjs}"],
      "env": {
        "jest": true
      },
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/unbound-method": "off",
        "typescript/strict-boolean-expressions": "off",
        "jest/no-conditional-expect": "off",
        "jest/valid-expect": "off"
      }
    },
    {
      "files": [
        "*.config.{js,mjs,ts,cjs}",
        "vite.config.ts",
        "vitest.unit.config.ts",
        "vitest.e2e.config.ts",
        "playwright.config.ts",
        "perf.config.ts",
        "scripts/**/*.{js,mjs,ts}"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/consistent-return": "off",
        "eslint/no-unused-vars": "off",
        "no-unused-vars": "warn"
      }
    },
    {
      "files": ["collaboration-server/**/*.{js,mjs,cjs}"],
      "env": {
        "node": true
      },
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["demo/**/*.{ts,js,mjs}"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["docs/**/*.{ts,js,mjs,vue}"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off"
      }
    }
  ]
}
