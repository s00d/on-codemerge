{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "oxc", "jest", "promise"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
    "demo/dist/**",
    "src/plugins/CodeBlockPlugin/utils/languages/definitions/**",
    "src/__mocks__/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-console": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "curly": ["error", "all"],

    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowAny": false,
        "allowNullableBoolean": true,
        "allowNullableNumber": false,
        "allowNullableObject": true,
        "allowNullableString": true,
        "allowNumber": true,
        "allowString": true
      }
    ],
    "typescript/consistent-return": "error",
    "typescript/no-misused-spread": "error",
    "typescript/prefer-nullish-coalescing": "off",
    "typescript/no-deprecated": "off",
    "typescript/no-confusing-void-expression": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-void-return": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/method-signature-style": "off",
    "typescript/parameter-properties": "off",
    "typescript/ban-types": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/prefer-for-of": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    "import/no-cycle": "error",
    "import/first": "error",
    "import/newline-after-import": "off",
    "import/no-duplicates": "off",
    "no-duplicate-imports": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "import/no-default-export": "off",
    "import/no-unassigned-import": "off",
    "import/no-anonymous-default-export": "off",
    "import/max-dependencies": "off",
    "import/no-nodejs-modules": "off",

    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/no-useless-switch-case": "off",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-number-coercion": "error",
    "unicorn/prefer-native-coercion-functions": "off",
    "unicorn/prefer-blob-reading-methods": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/prefer-single-call": "error",
    "unicorn/no-immediate-mutation": "off",

    "oxc/no-map-spread": "off",

    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/no-multiple-resolved": "error",
    "promise/always-return": "error",
    "promise/prefer-await-to-then": "error",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",

    "eslint/radix": "error",
    "eslint/no-await-in-loop": "off",
    "eslint/require-await": "error",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_exhaustive", "_onOut", "__ocmViewportManager"],
        "allowAfterThis": true,
        "enforceInMethodNames": false
      }
    ],
    "eslint/no-useless-return": "error",
    "eslint/max-depth": "off",
    "eslint/no-script-url": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-lonely-if": "error",
    "eslint/max-classes-per-file": "off",
    "eslint/default-param-last": "error",
    "eslint/no-loop-func": "error",
    "eslint/prefer-named-capture-group": "off",
    "eslint/no-nested-ternary": "off",

    "jest/prefer-ending-with-an-expect": "off",
    "jest/require-hook": "off",
    "jest/no-hooks": "off",
    "jest/require-top-level-describe": "off",
    "jest/no-conditional-in-test": "off",
    "jest/no-conditional-expect": "error",
    "jest/valid-expect": "error",
    "jest/max-expects": "off",
    "jest/prefer-strict-equal": "error",
    "jest/prefer-expect-assertions": "off",
    "jest/prefer-called-with": "error"
  },
  "overrides": [
    {
      "files": ["**/__mocks__/**/*.{ts,js,mjs}", "src/__mocks__/**/*.{ts,js,mjs}"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,js,mjs}", "**/__tests__/**/*.{ts,js,mjs}"],
      "env": {
        "jest": true
      },
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/unbound-method": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/ban-types": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "jest/no-conditional-expect": "off",
        "promise/prefer-await-to-then": "off",
        "promise/always-return": "off"
      }
    },
    {
      "files": [
        "*.config.{js,mjs,ts,cjs}",
        "vite.config.ts",
        "vitest.unit.config.ts",
        "vitest.e2e.config.ts",
        "playwright.config.ts",
        "perf.config.ts",
        "scripts/**/*.{js,mjs,ts}"
      ],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/consistent-return": "off",
        "typescript/require-await": "off",
        "no-unused-vars": "off",
        "promise/prefer-await-to-then": "off"
      }
    },
    {
      "files": ["collaboration-server/**/*.{js,mjs,cjs}"],
      "env": {
        "node": true
      },
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["demo/**/*.{ts,js,mjs}"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["docs/**/*.{ts,js,mjs,vue}"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
