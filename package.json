{
  "name": "on-codemerge",
  "version": "2.5.0",
  "description": "A WYSIWYG editor for on-codemerge is a user-friendly interface that allows users to edit and view their code in real time, exactly as it will appear in the final product",
  "keywords": [
    "JavaScript",
    "WYSIWYG",
    "admin",
    "code",
    "editor",
    "generator",
    "indo",
    "panel",
    "text",
    "typescript"
  ],
  "homepage": "https://s00d.github.io/on-codemerge/",
  "bugs": {
    "url": "https://github.com/s00d/on-codemerge/issues"
  },
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/app.cjs",
  "module": "./dist/app.mjs",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./app": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/packages/sdk/src/index.d.ts",
        "default": "./dist/packages/sdk/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/sdk/src/index.d.cts",
        "default": "./dist/packages/sdk/src/index.cjs"
      }
    },
    "./kernel": {
      "import": {
        "types": "./dist/packages/kernel/src/index.d.ts",
        "default": "./dist/packages/kernel/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/kernel/src/index.d.cts",
        "default": "./dist/packages/kernel/src/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.mjs"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.mjs"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./code": {
      "import": {
        "types": "./dist/code.d.ts",
        "default": "./dist/code.mjs"
      },
      "require": {
        "types": "./dist/code.d.cts",
        "default": "./dist/code.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms.d.ts",
        "default": "./dist/forms.mjs"
      },
      "require": {
        "types": "./dist/forms.d.cts",
        "default": "./dist/forms.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.mjs"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./calendar": {
      "import": {
        "types": "./dist/calendar.d.ts",
        "default": "./dist/calendar.mjs"
      },
      "require": {
        "types": "./dist/calendar.d.cts",
        "default": "./dist/calendar.cjs"
      }
    },
    "./index.css": "./dist/index.css",
    "./public.css": "./dist/public.css",
    "./public.js": "./dist/public.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./sdk.css": "./dist/packages/sdk/src/ui/sdk.css",
    "./package.json": "./package.json",
    "./plugins/*/style.css": "./dist/plugins/*/style.css"
  },
  "scripts": {
    "release": "pnpm run prepublishOnly && pnpm publish -r --filter './packages/kernel' --filter './packages/sdk' --filter './packages/hunspell' --filter './packages/collaboration-server' --filter '.' --access public --no-git-checks --ignore-scripts",
    "build:packages": "pnpm -r --filter '@codemerge/kernel' --filter '@codemerge/sdk' --filter '@codemerge/hunspell' --filter '@codemerge/collaboration-server' run build",
    "prepublishOnly": "pnpm run build:packages && pnpm run check && pnpm run build && pnpm run check:json-export && pnpm run check:json-types && pnpm run check:markdown-export && pnpm run check:markdown-types && pnpm run check:code-export && pnpm run check:code-types && pnpm run check:forms-export && pnpm run check:forms-types && pnpm run check:charts-export && pnpm run check:charts-types && pnpm run check:calendar-export && pnpm run check:calendar-types && pnpm run build:json && pnpm run build:markdown && pnpm run build:code && pnpm run build:forms && pnpm run build:charts && pnpm run build:calendar && pnpm run publint",
    "check:json-export": "node ./scripts/check-json-export.mjs",
    "check:json-types": "node ./scripts/check-json-types.mjs",
    "check:markdown-export": "node ./scripts/check-markdown-export.mjs",
    "check:markdown-types": "node ./scripts/check-markdown-types.mjs",
    "check:code-export": "node ./scripts/check-code-export.mjs",
    "check:code-types": "node ./scripts/check-code-types.mjs",
    "check:forms-export": "node ./scripts/check-forms-export.mjs",
    "check:forms-types": "node ./scripts/check-forms-types.mjs",
    "check:charts-export": "node ./scripts/check-charts-export.mjs",
    "check:charts-types": "node ./scripts/check-charts-types.mjs",
    "check:calendar-export": "node ./scripts/check-calendar-export.mjs",
    "check:calendar-types": "node ./scripts/check-calendar-types.mjs",
    "dev": "vite",
    "dev:json": "vite --config vite.json.config.ts",
    "dev:markdown": "vite --config vite.markdown.config.ts",
    "dev:code": "vite --config vite.code.config.ts",
    "dev:forms": "vite --config vite.forms.config.ts",
    "dev:charts": "vite --config vite.charts.config.ts",
    "dev:calendar": "vite --config vite.calendar.config.ts",
    "build": "vite build && vite build --config vite.public.config.ts",
    "build:json": "vite build --config vite.json.config.ts",
    "build:markdown": "vite build --config vite.markdown.config.ts",
    "build:code": "vite build --config vite.code.config.ts",
    "build:forms": "vite build --config vite.forms.config.ts",
    "build:charts": "vite build --config vite.charts.config.ts",
    "build:calendar": "vite build --config vite.calendar.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/check-sass-modern.mjs",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && pnpm run build:packages && oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/check-sass-modern.mjs && node ./scripts/check-locales.js && node ./scripts/check-hunspell-license.mjs && pnpm run typecheck && pnpm run publint:packages && pnpm run test:collab",
    "test:collab": "pnpm --filter '@codemerge/collaboration-server' test && pnpm exec vitest run packages/kernel/src/__tests__/transform.test.ts",
    "check:locales": "node ./scripts/check-locales.js",
    "publint": "pnpm run build:packages && pnpm run build && pnpm run publint:packages && publint --strict",
    "publint:packages": "pnpm -r --filter '@codemerge/kernel' --filter '@codemerge/sdk' --filter '@codemerge/hunspell' --filter '@codemerge/collaboration-server' run publint",
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.e2e.config.ts",
    "docs:dev": "vitepress dev docs",
    "collab:dev": "pnpm --filter '@codemerge/collaboration-server' run build && COLLAB_TOKEN=dev pnpm --filter '@codemerge/collaboration-server' exec node ./dist/cli.cjs serve --port 8787 --store memory",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "node --import tsx ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:perf": "untestutils perf --config ./perf.config.ts"
  },
  "dependencies": {
    "@i18n-micro/runtime": "catalog:",
    "dompurify": "catalog:",
    "mermaid": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@codemerge/editor": "workspace:^",
    "@codemerge/hunspell": "workspace:^",
    "@codemerge/kernel": "workspace:^",
    "@codemerge/sdk": "workspace:^",
    "@codemerge/wysiwyg": "workspace:^",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/dompurify": "catalog:",
    "@types/node": "catalog:",
    "@untestutils/perf": "catalog:",
    "@untestutils/vite": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dictionary-en": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "untestutils": "catalog:",
    "vite": "catalog:",
    "vite-plugin-banner": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-svg-loader": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2"
}
