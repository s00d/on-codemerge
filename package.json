    "@ocm/comments-plugin": "workspace:^",
    "@ocm/export-plugin": "workspace:^",
    "@ocm/file-upload-plugin": "workspace:^",
    "@ocm/font-plugin": "workspace:^",
    "@ocm/footer-plugin": "workspace:^",
    "@ocm/footnotes-plugin": "workspace:^",
    "@ocm/form-builder-plugin": "workspace:^",
    "@ocm/history-plugin": "workspace:^",
    "@ocm/html-viewer-plugin": "workspace:^",
    "@ocm/image-plugin": "workspace:^",
    "@ocm/json-plugin": "workspace:^",
    "@ocm/language-plugin": "workspace:^",
    "@ocm/link-plugin": "workspace:^",
    "@ocm/lists-plugin": "workspace:^",
    "@ocm/markdown-plugin": "workspace:^",
    "@ocm/math-plugin": "workspace:^",
    "@ocm/mentions-plugin": "workspace:^",
    "@ocm/pdf-embed-plugin": "workspace:^",
    "@ocm/plugins": "workspace:^",
    "@ocm/responsive-plugin": "workspace:^",
    "@ocm/shortcuts-plugin": "workspace:^",
    "@ocm/spell-checker-plugin": "workspace:^",
    "@ocm/table-plugin": "workspace:^",
    "@ocm/templates-plugin": "workspace:^",
    "@ocm/timer-plugin": "workspace:^",
