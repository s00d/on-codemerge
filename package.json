{
  "name": "on-codemerge",
  "version": "2.0.1",
  "description": "A WYSIWYG editor for on-codemerge is a user-friendly interface that allows users to edit and view their code in real time, exactly as it will appear in the final product",
  "keywords": [
    "JavaScript",
    "WYSIWYG",
    "admin",
    "code",
    "editor",
    "generator",
    "indo",
    "panel",
    "text",
    "typescript"
  ],
  "homepage": "https://s00d.github.io/on-codemerge/",
  "bugs": {
    "url": "https://github.com/s00d/on-codemerge/issues"
  },
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/app.cjs",
  "module": "./dist/app.mjs",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./app": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/packages/sdk/src/index.d.ts",
        "default": "./dist/packages/sdk/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/sdk/src/index.d.cts",
        "default": "./dist/packages/sdk/src/index.cjs"
      }
    },
    "./kernel": {
      "import": {
        "types": "./dist/packages/kernel/src/index.d.ts",
        "default": "./dist/packages/kernel/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/kernel/src/index.d.cts",
        "default": "./dist/packages/kernel/src/index.cjs"
      }
    },
    "./index.css": "./dist/index.css",
    "./public.css": "./dist/public.css",
    "./public.js": "./dist/public.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./sdk.css": "./dist/packages/sdk/src/ui/sdk.css",
    "./package.json": "./package.json",
    "./plugins/*/style.css": "./dist/src/plugins/*/style.css"
  },
  "scripts": {
    "release": "pnpm publish -r",
    "prepublishOnly": "pnpm run check && pnpm run build && pnpm run publint",
    "dev": "vite",
    "build": "vite build && vite build --config vite.public.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/check-sass-modern.mjs",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/check-sass-modern.mjs && node ./scripts/check-locales.js && pnpm run typecheck",
    "check:locales": "node ./scripts/check-locales.js",
    "publint": "publint --strict",
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.e2e.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "node --import tsx ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:perf": "untestutils perf --config ./perf.config.ts"
  },
  "dependencies": {
    "@i18n-micro/runtime": "^1.0.0",
    "dompurify": "^3.4.15",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "typo-js": "^1.3.2"
  },
  "devDependencies": {
    "@on-codemerge/kernel": "workspace:*",
    "@on-codemerge/sdk": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.15.34",
    "@types/typo-js": "^1.2.2",
    "@untestutils/perf": "^0.6.11",
    "@untestutils/vite": "^0.6.11",
    "@vitest/coverage-v8": "^5.0.1",
    "dictionary-en": "^4.0.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "postcss": "^8.5.28",
    "publint": "^0.3.24",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "untestutils": "^0.6.11",
    "vite": "^8.3.0",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2"
}
