{
  "name": "on-codemerge",
  "version": "2.7.1",
  "description": "A WYSIWYG editor for on-codemerge is a user-friendly interface that allows users to edit and view their code in real time, exactly as it will appear in the final product",
  "keywords": [
    "JavaScript",
    "WYSIWYG",
    "admin",
    "code",
    "editor",
    "generator",
    "indo",
    "panel",
    "text",
    "typescript"
  ],
  "homepage": "https://s00d.github.io/on-codemerge/",
  "bugs": {
    "url": "https://github.com/s00d/on-codemerge/issues"
  },
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/app.cjs",
  "module": "./dist/app.mjs",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./app": {
      "import": {
        "types": "./dist/app.d.ts",
        "default": "./dist/app.mjs"
      },
      "require": {
        "types": "./dist/app.d.cts",
        "default": "./dist/app.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.mjs"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./sdk": {
      "import": {
        "types": "./dist/packages/sdk/src/index.d.ts",
        "default": "./dist/packages/sdk/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/sdk/src/index.d.cts",
        "default": "./dist/packages/sdk/src/index.cjs"
      }
    },
    "./kernel": {
      "import": {
        "types": "./dist/packages/kernel/src/index.d.ts",
        "default": "./dist/packages/kernel/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/kernel/src/index.d.cts",
        "default": "./dist/packages/kernel/src/index.cjs"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/packages/view/src/index.d.ts",
        "default": "./dist/packages/view/src/index.mjs"
      },
      "require": {
        "types": "./dist/packages/view/src/index.d.cts",
        "default": "./dist/packages/view/src/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.mjs"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.mjs"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./code": {
      "import": {
        "types": "./dist/code.d.ts",
        "default": "./dist/code.mjs"
      },
      "require": {
        "types": "./dist/code.d.cts",
        "default": "./dist/code.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms.d.ts",
        "default": "./dist/forms.mjs"
      },
      "require": {
        "types": "./dist/forms.d.cts",
        "default": "./dist/forms.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.mjs"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./calendar": {
      "import": {
        "types": "./dist/calendar.d.ts",
        "default": "./dist/calendar.mjs"
      },
      "require": {
        "types": "./dist/calendar.d.cts",
        "default": "./dist/calendar.cjs"
      }
    },
    "./tables": {
      "import": {
        "types": "./dist/tables.d.ts",
        "default": "./dist/tables.mjs"
      },
      "require": {
        "types": "./dist/tables.d.cts",
        "default": "./dist/tables.cjs"
      }
    },
    "./index.css": "./dist/index.css",
    "./public.css": "./dist/public.css",
    "./public.js": "./dist/public.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "release": "pnpm run prepublishOnly && pnpm publish -r --filter './packages/kernel' --filter './packages/view' --filter './packages/mermaid' --filter './packages/sdk' --filter './packages/hunspell' --filter './packages/collaboration-server' --filter '.' --access public --no-git-checks --ignore-scripts",
    "build:packages": "pnpm -r --filter '@codemerge/kernel' --filter '@codemerge/view' --filter '@codemerge/mermaid' --filter '@codemerge/sdk' --filter '@codemerge/hunspell' --filter '@codemerge/collaboration-server' run build",
    "prepublishOnly": "pnpm run build:packages && pnpm run check && pnpm run build && pnpm run check:public-bundle && pnpm run check:dist-package && pnpm run check:surfaces && pnpm run build:json && pnpm run build:markdown && pnpm run build:code && pnpm run build:forms && pnpm run build:charts && pnpm run build:calendar && pnpm run build:tables && pnpm run publint",
    "check:public-bundle": "node ./scripts/check-public-bundle.mjs",
    "check:dist-package": "node ./scripts/check-dist-package.mjs",
    "check:surfaces": "node ./scripts/check-surface.mjs all",
    "dev": "vite",
    "dev:json": "vite --config apps/json/vite.config.ts",
    "dev:markdown": "vite --config apps/markdown/vite.config.ts",
    "dev:code": "vite --config apps/code/vite.config.ts",
    "dev:forms": "vite --config apps/forms/vite.config.ts",
    "dev:charts": "vite --config apps/charts/vite.config.ts",
    "dev:calendar": "vite --config apps/calendar/vite.config.ts",
    "dev:tables": "vite --config apps/tables/vite.config.ts",
    "build": "pnpm --filter @codemerge/sdk build && vite build && vite build --config vite.styles.config.ts && vite build --config apps/wysiwyg/vite.public.config.ts",
    "build:json": "vite build --config apps/json/vite.config.ts",
    "build:markdown": "vite build --config apps/markdown/vite.config.ts",
    "build:code": "vite build --config apps/code/vite.config.ts",
    "build:forms": "vite build --config apps/forms/vite.config.ts",
    "build:charts": "vite build --config apps/charts/vite.config.ts",
    "build:calendar": "vite build --config apps/calendar/vite.config.ts",
    "build:tables": "vite build --config apps/tables/vite.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/ban-plugin-wysiwyg-utils.mjs && node ./scripts/check-sass-modern.mjs",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && pnpm run build:packages && oxlint --type-aware --deny-warnings . && node ./scripts/ban-plugin-dom.mjs && node ./scripts/ban-plugin-wysiwyg-utils.mjs && node ./scripts/check-sass-modern.mjs && node ./scripts/check-locales.js && node ./scripts/check-hunspell-license.mjs && pnpm run typecheck && pnpm run publint:packages && pnpm run test:collab",
    "test:collab": "pnpm --filter '@codemerge/collaboration-server' test && pnpm exec vitest run packages/kernel/src/__tests__/transform.test.ts",
    "check:locales": "node ./scripts/check-locales.js",
    "publint": "pnpm run build:packages && pnpm run build && pnpm run publint:packages && publint --strict",
    "publint:packages": "pnpm -r --filter '@codemerge/kernel' --filter '@codemerge/view' --filter '@codemerge/mermaid' --filter '@codemerge/sdk' --filter '@codemerge/hunspell' --filter '@codemerge/collaboration-server' run publint",
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.e2e.config.ts",
    "docs:dev": "node ./scripts/ensure-dist-css.mjs && vitepress dev docs",
    "collab:dev": "pnpm --filter '@codemerge/collaboration-server' run build && COLLAB_TOKEN=dev pnpm --filter '@codemerge/collaboration-server' exec node ./dist/cli.cjs serve --port 8787 --store memory",
    "docs:build": "node ./scripts/ensure-dist-css.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "node --import tsx ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:perf": "untestutils perf --config ./perf.config.ts"
  },
  "dependencies": {
    "@codemerge/mermaid": "workspace:^",
    "@i18n-micro/runtime": "catalog:",
    "dompurify": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@codemerge/editor": "workspace:^",
    "@codemerge/hunspell": "workspace:^",
    "@codemerge/kernel": "workspace:^",
