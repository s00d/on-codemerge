    "@ocm/youtube-video-plugin": "workspace:^",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/dompurify": "catalog:",
    "@types/node": "catalog:",
    "@untestutils/perf": "catalog:",
    "@untestutils/vite": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dictionary-en": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "publint": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "untestutils": "catalog:",
    "vite": "catalog:",
    "vite-plugin-banner": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-svg-loader": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.14.2"
}
