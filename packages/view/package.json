{
  "name": "@codemerge/view",
  "version": "2.7.2",
  "description": "Tiny ViewSpec DOM runtime — hyperscript mount/patch/portal without the editor",
  "keywords": [
    "dom",
    "hyperscript",
    "mount",
    "portal",
    "typescript",
    "viewspec"
  ],
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git",
    "directory": "packages/view"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "publint": "publint --strict",
    "prepublishOnly": "pnpm run build && pnpm run publint"
  },
  "engines": {
    "node": ">=20"
  }
}
