{
  "name": "@codemerge/sdk",
  "version": "2.5.1",
  "description": "Plugin API and UI primitives for CodeMerge editors",
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "src/ui/sdk.scss",
    "src/ui/tw-ref.css",
    "src/ui/ocm-theme.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "./dist/sdk.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.mjs"
      },
      "require": {
        "types": "./dist/ui/index.d.cts",
        "default": "./dist/ui/index.cjs"
      }
    },
    "./ui/chrome": {
      "import": {
        "types": "./dist/ui/chrome.d.ts",
        "default": "./dist/ui/chrome.mjs"
      },
      "require": {
        "types": "./dist/ui/chrome.d.cts",
        "default": "./dist/ui/chrome.cjs"
      }
    },
    "./ui/sdk.scss": "./src/ui/sdk.scss",
    "./sdk.css": "./dist/sdk.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "publint": "publint --strict",
    "prepublishOnly": "pnpm run build && pnpm run publint"
  },
  "dependencies": {
    "@codemerge/kernel": "workspace:^",
    "@codemerge/view": "workspace:^",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
