{
  "name": "@codemerge/collaboration-server",
  "version": "1.0.0",
  "description": "Demo WebSocket ops relay for CodeMerge CollaborationPlugin",
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git",
    "directory": "packages/collaboration-server"
  },
  "bin": {
