{
  "name": "@codemerge/kernel",
  "version": "2.7.0",
  "description": "Headless document / ops / selection model for CodeMerge editors",
  "license": "MIT",
  "author": "Pavel Kuzmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/on-codemerge.git",
    "directory": "packages/kernel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "publint": "publint --strict",
    "prepublishOnly": "pnpm run build && pnpm run publint"
  },
  "engines": {
    "node": ">=20"
  }
}
