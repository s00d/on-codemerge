{
  "name": "@codemerge/wysiwyg",
  "version": "2.8.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "**/*.svg"
  ],
  "main": "./src/app.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./public.css": "./src/public.css",
    "./index.scss": "./src/index.scss"
  },
  "dependencies": {
    "@codemerge/editor": "workspace:^",
    "@codemerge/hunspell": "workspace:^",
    "@codemerge/kernel": "workspace:^",
    "@codemerge/sdk": "workspace:^",
    "@i18n-micro/runtime": "catalog:"
  }
}
